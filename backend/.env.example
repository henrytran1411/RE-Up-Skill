NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=devperf

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# "Sign in with Microsoft" — register an app at https://portal.azure.com (Entra ID > App registrations).
# Set the redirect URI there to exactly match MICROSOFT_CALLBACK_URL.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
# "common" allows both work/school and personal Microsoft accounts to sign in.
MICROSOFT_TENANT=common
# Where the browser is sent back to after a Microsoft sign-in completes.
FRONTEND_URL=http://localhost:5173

# Backlog Generator (Epic/User Story/Task from a plain-text project description) - free key at https://aistudio.google.com/apikey.
# Blank GEMINI_API_KEY disables the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
